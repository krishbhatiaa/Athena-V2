# ---- Redis ----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---- CORS (comma-separated origins) --------------------------------------
CORS_ORIGINS=http://localhost:80,http://localhost:3000

# ---- Guardrail thresholds (optional overrides) ---------------------------
# ATHENA_MAX_DRAWDOWN=1.0       # percent; halt trading beyond this drawdown
# ATHENA_VOL_KILL=0.50          # annualized sigma; kill switch if exceeded
# ATHENA_MIN_CONFIDENCE=0.52    # p_trade floor below which Supervisor holds
# ATHENA_MAX_RISK_SCORE=70      # composite 0-100 risk score ceiling
# ATHENA_KELLY_CAP=0.25         # hard cap on Kelly fraction, regardless of edge

# ---- Ollama (optional LLM for enhanced narratives / explainability) -------
# When Ollama is running (localhost or Docker), the ContentAgent and
# explainability module use it automatically. Falls back to deterministic
# templates when Ollama is unreachable.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=30
OLLAMA_ENABLED=true
