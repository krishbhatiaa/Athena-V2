{
  "title": "ATHENA — War Room Observability",
  "uid": "athena-v2",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "HTTP Request Rate",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "rate(http_requests_total{job=\"athena_backend\"}[1m])", "legendFormat": "req/s" }]
    },
    {
      "id": 2, "type": "stat", "title": "P95 Latency (ms)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"athena_backend\"}[1m])) * 1000", "legendFormat": "p95 ms" }]
    },
    {
      "id": 3, "type": "stat", "title": "Uptime (sec)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "process_start_time_seconds{job=\"athena_backend\"}", "legendFormat": "start" }]
    },
    {
      "id": 4, "type": "timeseries", "title": "Request Rate Over Time",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 8 },
      "targets": [
        { "expr": "rate(http_requests_total{job=\"athena_backend\",status=~\"2..\"}[1m])", "legendFormat": "2xx" },
        { "expr": "rate(http_requests_total{job=\"athena_backend\",status=~\"5..\"}[1m])", "legendFormat": "5xx" }
      ]
    },
    {
      "id": 5, "type": "timeseries", "title": "Latency Percentiles",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket[1m])) * 1000", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[1m])) * 1000", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[1m])) * 1000", "legendFormat": "p99" }
      ]
    }
  ]
}
